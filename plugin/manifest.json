{
  "name": "Edit in PhotoCraft by @raphaelareas",
  "id": "editar-no-photocraft-web",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": [
    "figma"
  ],
  "documentAccess": "dynamic-page",
  "relaunchButtons": [
    {
      "command": "editar",
      "name": "Edit in PhotoCraft"
    }
  ],
  "networkAccess": {
    "allowedDomains": [
      "https://raphaelareas.github.io"
    ],
    "devAllowedDomains": [
      "http://localhost:47616"
    ],
    "reasoning": "Opens the PhotoCraft image editor (open-source web version) inside the plugin. The image goes from Figma to the editor and back, all on the user's computer."
  }
}
